{
  "name": "blog",
  "version": "1.0.0",
  "description": "A simple blog application",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "bun --filter frontend dev",
    "dev:backend": "bun --filter backend dev",
    "build:frontend": "bun --filter frontend build",
    "lint": "bun --filter frontend lint",
    "format": "prettier --write .",
    "prepare": "husky || true",
    "start": "concurrently \"bun start:frontend\" \"bun start:backend\"",
    "start:backend": "bun --filter backend start",
    "start:frontend": "bun --filter frontend start --port 4322",
    "check-format": "prettier --check ."
  },
  "keywords": [
    "blog"
  ],
  "author": "wei0911",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^25.2.0",
    "concurrently": "^9.2.0",
    "husky": "^9.1.7",
    "prettier": "3.6.2",
    "prettier-plugin-organize-imports": "^4.2.0",
    "prettier-plugin-packagejson": "^3.0.0",
    "typescript": "^5.7.2"
  }
}
